class_name Groups
## Names of the scene groups the game uses, so code never spells a group name as a bare string.
## Each one is also declared under Project Settings > Global Groups.

## The root of a legacy play map (EnchantmentMap)
const ENCHANTMENT_MAP := &"enchantment_map"
## Every MapNode on a legacy play map
const MAP_NODE := &"mapnode"
## Every MapLine on a legacy play map
const MAP_LINE := &"mapline"
## Every EnchantmentGrid on a legacy play map
const ENCHANTMENT := &"enchantment"
## The workplace's channel area
const CHANNEL := &"channel"
## The workplace's channel controller
const CHANNEL_CONTROLLER := &"channel_controller"
## The workplace's workstation area
const WORKSTATION := &"workstation"
## The workplace's workstation controller
const WORKSTATION_CONTROLLER := &"workstation_controller"
## The workstation's proxy cursor inside its SubViewport
const WORKSTATION_CURSOR := &"workstation_cursor"
## The workplace's main (screen-space) cursor
const CURSOR := &"cursor"
