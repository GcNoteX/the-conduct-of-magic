[sub_resource type="TileSetAtlasSource" id="TileSetAtlasSource_cells"]
resource_name = "Cells"
texture = ExtResource("1_cell")
texture_region_size = Vector2i(56, 64)
0:0/0 = 0

[sub_resource type="TileSetAtlasSource" id="TileSetAtlasSource_magic"]
resource_name = "Magic nodes"
