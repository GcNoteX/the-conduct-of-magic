[gd_resource type="TileSet" format=3]

[ext_resource type="Texture2D" path="res://art/placeholder/cell_steel.png" id="1_cell"]
[ext_resource type="Texture2D" path="res://art/placeholder/magic_node_tiles.png" id="2_magic"]
[ext_resource type="Script" path="res://disenchanting/rune_set.gd" id="3_runes"]

[sub_resource type="Resource" id="Resource_water_edge"]
