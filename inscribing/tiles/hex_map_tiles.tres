1:0/0/custom_data_2 = SubResource("Resource_fire_harvest")
2:0/0 = 0
2:0/0/custom_data_0 = true
2:0/0/custom_data_1 = SubResource("Resource_wind_edge")
2:0/0/custom_data_2 = SubResource("Resource_wind_harvest")
3:0/0 = 0
3:0/0/custom_data_0 = true
3:0/0/custom_data_1 = SubResource("Resource_stone_edge")
3:0/0/custom_data_2 = SubResource("Resource_stone_harvest")

[resource]
tile_shape = 3
tile_size = Vector2i(56, 64)
custom_data_layer_0/name = "magic_node"
custom_data_layer_0/type = 1
custom_data_layer_1/name = "edge_runes"
